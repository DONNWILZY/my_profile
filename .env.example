# Optional public API origin when the static frontend and booking server are hosted separately.
# Leave empty when npm run dev or npm start serves the API on the same origin.
# Example: https://appointments.your-domain.com
VITE_SCHEDULE_API_URL=
# Optional email address for contact links.
VITE_CONTACT_EMAIL=
# Full deployed frontend URL, including its subdirectory, for social images.
VITE_SITE_URL=
# Server environment (set in your shell/hosting environment, not exposed to visitors):
# PORT=8787
# HOST=127.0.0.1
# SCHEDULE_DATA_FILE=/durable/private/path/appointments.json
# SCHEDULE_ALLOWED_ORIGINS=https://your-frontend-domain.com
